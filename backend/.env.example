# Server
PORT=5000

# Persistence — set USE_DB=true and MONGO_URI to use MongoDB Atlas instead
# of the in-memory store.
USE_DB=false
MONGO_URI=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# Used to build the password-reset link that gets emailed to the user,
# e.g. https://your-frontend-domain.com
FRONTEND_URL=

# Resend — used to actually email password-reset links (backend/src/utils/mailer.js).
# If RESEND_API_KEY isn't set, reset links are logged to the server console
# instead of being emailed, so local dev still works without a real key.
#
# We use Resend's HTTP API (not SMTP) because Render — and many free-tier
# hosts — block outbound SMTP ports (25/465/587) to prevent spam abuse.
# Resend sends over normal HTTPS (port 443), which always works.
#
# Setup:
#   1. Sign up at https://resend.com and grab an API key.
#   2. RESEND_API_KEY=re_your_key_here
#   3. EMAIL_FROM: while testing, leave unset to use Resend's shared sandbox
#      sender (onboarding@resend.dev) — this only delivers to the email
#      address you signed up to Resend with. To send to *any* address,
#      verify your own domain in Resend and set EMAIL_FROM to an address
#      on that domain, e.g. no-reply@yourdomain.com.
RESEND_API_KEY=
EMAIL_FROM=

ML_SERVICE_URL=http://localhost:5001
