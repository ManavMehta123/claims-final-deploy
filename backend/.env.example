# Server
PORT=5000

# Persistence — set USE_DB=true and MONGO_URI to use MongoDB Atlas instead
# of the in-memory store.
USE_DB=false
MONGO_URI=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# Used to build the password-reset link that gets emailed to the user,
# e.g. https://your-frontend-domain.com
FRONTEND_URL=

# SMTP — used to actually email password-reset links (backend/src/utils/mailer.js).
# If these aren't set, reset links are logged to the server console instead
# of being emailed, so local dev still works without real credentials.
#
# Gmail example (use an "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Mailtrap (safe for local/dev testing - emails never leave Mailtrap):
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=<from Mailtrap inbox settings>
#   SMTP_PASS=<from Mailtrap inbox settings>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

ML_SERVICE_URL=http://localhost:5001
